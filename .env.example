GESTALT_ENV=development
GESTALT_APP_NAME=gestalt-core
GESTALT_CONFIG_PATH=config/gestalt.yaml
GESTALT_API_HOST=0.0.0.0
GESTALT_API_PORT=8080
GESTALT_ADMIN_TOKEN=change-me

GESTALT_DATABASE_URL=postgresql+asyncpg://gestalt:gestalt@postgres:5432/gestalt
GESTALT_DATABASE_ECHO=false
GESTALT_NEO4J_URI=bolt://neo4j:7687
GESTALT_NEO4J_USERNAME=neo4j
GESTALT_NEO4J_PASSWORD=change-me
GESTALT_REDIS_URL=redis://redis:6379/0

GESTALT_ENABLE_MOCK_LLM=true
GESTALT_MODEL_DEFAULT=mock://gestalt-default
GESTALT_MODEL_HIGH=mock://gestalt-high
GESTALT_MODEL_CRITICAL=mock://gestalt-critical
GESTALT_EMBEDDING_MODEL=mock://embedding

GESTALT_AUDIT_INTERVAL_HOURS=4
GESTALT_MONITOR_INTERVAL_MINUTES=5
GESTALT_LOG_LEVEL=INFO

GESTALT_OTEL_ENABLED=false
GESTALT_OTEL_SERVICE_NAME=gestalt-core
GESTALT_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

LITELLM_API_BASE=
LITELLM_API_KEY=
